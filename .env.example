# Django
SECRET_KEY=your-super-secret-key-here-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL - use DATABASE_URL or the individual vars
# Recommended for simplicity: 
# Docker Compose (docker compose up -d) maps Postgres to host port 5435
DATABASE_URL=postgres://careforsheperds:careforsheperds@localhost:5435/careforsheperds

# Or separate:
# DB_NAME=careforsheperds
# DB_USER=careforsheperds
# DB_PASSWORD=careforsheperds
# DB_HOST=localhost
# DB_PORT=5432

# KeshoPay (one merchant account for the platform)
KESHOPAY_PUBLIC_KEY=
KESHOPAY_PRIVATE_KEY=
KESHOPAY_WALLET_ID=
KESHOPAY_BASE_URL=https://api.keshopay.co.ke   # confirm exact with their team
KESHOPAY_WEBHOOK_SECRET=   # if they provide signature verification

# CORS (comma-separated origins allowed to call /api/*)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
TIME_ZONE=Africa/Nairobi
